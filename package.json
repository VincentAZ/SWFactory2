{
  "name": "stackworks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StackWorks — an interactive 3D museum exhibit that teaches how modern software applications work and how to build them with AI.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "shots": "node scripts/shoot.mjs http://localhost:4173/ /tmp/sw-shots"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
